# Local development only. Replace placeholders with independently generated secrets.
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://health:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/health_copilot
STORAGE_DIR=data/storage
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_HOURS=24
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SUMMARY_MODEL=sarvam-105b
# All AI runs through authenticated HTTPS APIs; keys are backend-only.
LAYA_API_KEY=
LAYA_BASE_URL=https://laya-model.com
LAYA_MODEL=multilingual
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=REPLACE_WITH_RANDOM_TOKEN
# Docker Compose uses these passwords (hex characters avoid URL escaping issues).
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
